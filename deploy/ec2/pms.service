[Unit]
Description=Property Management System
After=network.target mssql-server.service
Wants=network.target

[Service]
User=pms
WorkingDirectory=/opt/pms/app
EnvironmentFile=/opt/pms/app/.env
ExecStart=/home/pms/.sdkman/candidates/java/current/bin/java -jar /opt/pms/app/property-management-0.0.1-SNAPSHOT.jar
SuccessExitStatus=143
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
